# =========================================================
# Render Production Environment Variables
# Copy and paste these into your Render Dashboard under:
# Service > Environment > Add Environment Variable
# =========================================================

NODE_ENV=production
FRONTEND_URL=https://inkerrobotics.onrender.com
NEXT_PUBLIC_SITE_URL=https://inkerrobotics.onrender.com
NEXT_PUBLIC_API_URL=https://inkerrobotics.onrender.com
NOTIFY_EMAIL=info@inkerrobotics.com

# Supabase PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Credentials
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=[supabase-anon-key]

# Admin Authentication Secret
ADMIN_SECRET=[choose-a-long-random-secret]

# Email Service (Resend)
RESEND_API_KEY=re_[your-resend-key]

# Google reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LdhWBctAAAAAOffK5BWiQPitSYCaI9_VK5d4tZO
RECAPTCHA_SECRET_KEY=[recaptcha-secret]
