/* ---------------------------------------------------------------
   INKER ROBOTICS – Design System
   Navy + Orange industrial / future-tech aesthetic
   --------------------------------------------------------------- */

:root {
  --navy:        #1F3A6D;
  --navy-deep:   #15264A;
  --navy-ink:    #0B1730;
  --orange:      #F37021;
  --orange-bright:#FF7E2D;
  --orange-deep: #D85A12;
  --bone:        #F6F3EC;
  --paper:       #FBF9F4;
  --line:        #E4DED1;
  --ink:         #0A0F1C;
  --slate:       #56627A;
  --slate-soft:  #8993A8;

  --radius:      4px;
  --radius-lg:   8px;

  --container:   1280px;
  --gutter:      clamp(20px, 4vw, 56px);

  --font-display:'Barlow Condensed', 'Arial Narrow', sans-serif;
  --font-body:   'Inter', system-ui, -apple-system, sans-serif;
  --font-mono:   'JetBrains Mono', ui-monospace, monospace;

  --t-fast:      200ms cubic-bezier(.16,1,.3,1);
  --t-med:       450ms cubic-bezier(.16,1,.3,1);
  --t-smooth:    700ms cubic-bezier(.16,1,.3,1);
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
}

section[id], article[id] { scroll-margin-top: 88px; }

img { max-width: 100%; display: block; }

a { color: inherit; text-decoration: none; }

::selection { background: var(--orange); color: #fff; }

/* ---------------------- Type ----------------------- */
.display, h1, h2, h3 {
  font-family: var(--font-display);
  font-weight: 900;
  font-style: italic;
  letter-spacing: -0.005em;
  line-height: 0.92;
  color: var(--navy-ink);
  margin: 0;
  text-transform: uppercase;
}
h1 { font-size: clamp(48px, 7.2vw, 120px); }
h2 { font-size: clamp(38px, 4.6vw, 66px); }
h3 { font-size: clamp(26px, 2.6vw, 40px); }
h4 {
  font-family: var(--font-display);
  font-weight: 700;
  font-style: italic;
  font-size: clamp(20px, 1.6vw, 26px);
  letter-spacing: 0.005em;
  line-height: 1.05;
  text-transform: uppercase;
  margin: 0;
  color: var(--navy-ink);
}

p { margin: 0; color: var(--ink); }

.kicker {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--orange);
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 10px;
}
.kicker::before {
  content: "";
  width: 28px; height: 1px;
  background: var(--orange);
  display: inline-block;
}

.lead {
  font-size: clamp(17px, 1.4vw, 22px);
  color: var(--slate);
  line-height: 1.5;
  max-width: 64ch;
}

.eyebrow {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--slate-soft);
  font-weight: 500;
}

.mono { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; }

/* ---------------------- Layout ----------------------- */
.container {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 var(--gutter);
}
section { padding: clamp(60px, 7vw, 100px) 0; }

.grid { display: grid; gap: 24px; }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }
@media (max-width: 980px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}

/* ---------------------- Buttons ----------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 16px 26px;
  border-radius: var(--radius);
  font-family: var(--font-display);
  font-weight: 700;
  font-style: italic;
  font-size: 17px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform var(--t-fast), background var(--t-fast), color var(--t-fast), border-color var(--t-fast), box-shadow var(--t-fast);
  white-space: nowrap;
}
.btn:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 14px 30px -14px rgba(11,23,48,0.35); }
.btn:active { transform: translateY(0) scale(0.98); }
@media (max-width: 600px) {
  .btn { white-space: normal; text-align: center; }
}
.btn-primary {
  background: var(--orange);
  color: #fff;
}
.btn-primary:hover { background: var(--orange-bright); box-shadow: 0 14px 32px -12px rgba(243,112,33,0.55); }
.btn-secondary {
  background: transparent;
  color: var(--navy-ink);
  border-color: var(--navy-ink);
}
.btn-secondary:hover { background: var(--navy-ink); color: #fff; box-shadow: 0 14px 30px -14px rgba(11,23,48,0.3); }
.btn-dark {
  background: var(--navy-ink);
  color: #fff;
}
.btn-dark:hover { background: var(--navy-deep); box-shadow: 0 14px 30px -14px rgba(11,23,48,0.45); }
.btn-ghost {
  background: transparent;
  color: #fff;
  border-color: rgba(255,255,255,0.5);
}
.btn-ghost:hover { background: #fff; color: var(--navy-ink); border-color: #fff; box-shadow: 0 14px 30px -14px rgba(255,255,255,0.35); }
.btn .arrow { transition: transform var(--t-fast); }
.btn:hover .arrow { transform: translateX(6px); }

/* ---------------------- Nav ----------------------- */
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(251,249,244,0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
  box-shadow: 0 8px 24px -16px rgba(11,23,48,0);
  transition: box-shadow var(--t-med), border-color var(--t-med);
}
.nav.scrolled {
  box-shadow: 0 8px 24px -16px rgba(11,23,48,0.25);
  border-color: transparent;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px var(--gutter);
  transition: padding var(--t-med);
  max-width: var(--container);
  margin: 0 auto;
}
.nav.scrolled .nav-inner { padding: 12px var(--gutter); }
.nav-logo img { height: 38px; width: auto; transition: height var(--t-med); }
.nav.scrolled .nav-logo img { height: 32px; }
.nav-links {
  display: flex;
  align-items: center;
  gap: 36px;
}
.nav-links a {
  font-family: var(--font-display);
  font-weight: 600;
  font-style: italic;
  font-size: 16px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--navy-ink);
  position: relative;
  transition: color var(--t-fast);
}
.nav-links a::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: -6px;
  height: 2px;
  background: var(--orange);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--t-fast);
}
.nav-links a:hover::after,
.nav-links a.active::after { transform: scaleX(1); }
.nav-links a.active { color: var(--orange); }
.nav-links a.nav-cta::after { display: none; }

.nav-links a.nav-cta {
  background: var(--orange);
  color: #fff;
  padding: 10px 18px;
  border-radius: 4px;
  font-family: var(--font-display);
  font-weight: 700;
  font-style: italic;
  font-size: 14px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  transition: background var(--t-fast), transform var(--t-fast);
}
.nav-cta:hover { background: var(--orange-bright); transform: translateY(-1px); }

.nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 8px; }

/* ---------------------- Nav dropdown ----------------------- */
.nav-item-drop {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.nav-item-drop > a .caret {
  font-size: 9px;
  margin-left: 4px;
  display: inline-block;
  transition: transform var(--t-fast);
  color: var(--orange);
}
.nav-item-drop:hover > a .caret { transform: rotate(-180deg); }

.nav-drop {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translate(-50%, 8px);
  min-width: 320px;
  background: var(--navy-ink);
  color: #fff;
  padding: 14px;
  border-radius: 6px;
  box-shadow: 0 30px 60px -20px rgba(11,23,48,0.4);
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--t-fast), transform var(--t-fast);
  z-index: 200;
}
/* hover bridge so cursor can cross the gap */
.nav-drop::before {
  content: "";
  position: absolute;
  top: -14px; left: 0; right: 0; height: 14px;
}
.nav-item-drop:hover .nav-drop,
.nav-item-drop:focus-within .nav-drop {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, 0);
}
.nav-drop-label {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--orange);
  padding: 6px 12px 10px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  margin-bottom: 6px;
}
.nav-drop a {
  display: flex !important;
  align-items: center;
  gap: 14px;
  padding: 10px 12px !important;
  font-family: var(--font-display) !important;
  font-weight: 600 !important;
  font-style: italic !important;
  font-size: 15px !important;
  letter-spacing: 0.03em !important;
  text-transform: none !important;
  color: rgba(255,255,255,0.85) !important;
  border-radius: 4px;
  transition: background var(--t-fast), color var(--t-fast);
}
.nav-drop a:hover { background: rgba(243,112,33,0.18); color: #fff !important; }
.nav-drop a::after { display: none !important; }
.nav-drop-num {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--orange);
  font-weight: 500;
  font-style: normal;
  min-width: 18px;
}

@media (max-width: 980px) {
  .nav-links { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--paper); flex-direction: column; padding: 24px var(--gutter); gap: 14px; border-bottom: 1px solid var(--line); align-items: stretch !important; max-height: calc(100vh - 75px); overflow-y: auto; }
  .nav-links.open { display: flex; }
  .nav-toggle { display: block; }
  .nav-cta { display: none; }

  /* On mobile, dropdown groups behave like a single nav link — no expand, no list */
  .nav-item-drop { display: block; }
  .nav-item-drop > a .caret { display: none; }
  .nav-drop { display: none !important; }
}

/* ---------------------- Footer ----------------------- */
.footer {
  background: var(--navy-ink);
  color: #fff;
  padding: 80px 0 40px;
}
.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr repeat(3, 1fr);
  gap: 48px;
  margin-bottom: 48px;
}
@media (max-width: 980px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; } }
.footer h5 {
  font-family: var(--font-display);
  font-weight: 700;
  font-style: italic;
  font-size: 14px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--orange);
  margin: 0 0 18px;
}
.footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
.footer ul a { color: rgba(255,255,255,0.75); font-size: 14px; transition: color var(--t-fast); }
.footer ul a:hover { color: var(--orange); }
.footer-tag {
  font-family: var(--font-display);
  font-weight: 900;
  font-style: italic;
  font-size: 28px;
  text-transform: uppercase;
  color: #fff;
  line-height: 1;
  margin: 16px 0 12px;
}
.footer-blurb { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.6; max-width: 36ch; }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.12);
  padding-top: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  font-family: var(--font-mono);
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.05em;
}
.footer-logo { height: 36px; filter: brightness(0) invert(1); }
.footer-bottom-links { display: flex; gap: 24px; }

/* ---------------------- Cards ----------------------- */
.card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 32px;
  transition: transform var(--t-med), border-color var(--t-med), box-shadow var(--t-med);
  position: relative;
  overflow: hidden;
}
.card:hover {
  transform: translateY(-4px);
  border-color: var(--orange);
  box-shadow: 0 30px 60px -30px rgba(31,58,109,0.25);
}
.card-num {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--slate-soft);
  letter-spacing: 0.1em;
}

/* ---------------------- Section header ----------------------- */
.section-head {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 60px;
  align-items: end;
  margin-bottom: 40px;
}
@media (max-width: 980px) { .section-head { grid-template-columns: 1fr; gap: 24px; } }
.section-head .lead { margin-top: 18px; }

/* ---------------------- Stat / counter ----------------------- */
.stats-strip {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
@media (max-width: 980px) {
  .stats-strip { grid-template-columns: repeat(2,1fr); }
  .stat:nth-child(5) { grid-column: 1 / -1; border-top: 1px solid var(--line); }
}
.stat {
  padding: 32px 24px;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.stat:last-child { border-right: none; }
.stat-num {
  font-family: var(--font-display);
  font-weight: 900;
  font-style: italic;
  font-size: clamp(40px, 5vw, 64px);
  line-height: 1;
  color: var(--navy-ink);
  display: flex;
  align-items: baseline;
}
.stat-num .plus { color: var(--orange); margin-left: 2px; }
.stat-label {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--slate);
}

/* ---------------------- Image placeholder ----------------------- */
.media {
  position: relative;
  background: repeating-linear-gradient(45deg, #ECE6D6 0 10px, #E4DDC9 10px 20px);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 280px;
  border: 1px solid var(--line);
}
.media::after {
  content: attr(data-label);
  position: absolute;
  top: 16px; left: 16px;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--slate);
  background: var(--paper);
  padding: 4px 8px;
  border-radius: 3px;
}
.media-dark {
  background: repeating-linear-gradient(45deg, #1B2B4A 0 10px, #15233D 10px 20px);
}
.media-dark::after { color: rgba(255,255,255,0.7); background: var(--navy-ink); }

/* Photos inside a .media placeholder must always fill it, regardless of
   the container's height source (min-height vs. flex/grid stretch) —
   otherwise percentage-height images collapse to 0 and show as a tiny
   image floating in the striped placeholder background. */
.media > img {
  position: absolute;
  inset: 0;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
}

/* Gentle image zoom on card hover */
.media img, .media-visual img, .gallery-photo img {
  transition: transform var(--t-smooth);
}
.product-card:hover .media img,
.lab-card:hover .media img,
.solution-card:hover .media img,
.case:hover .media img,
.media-item:hover .media-visual img,
.gallery-photo:hover img {
  transform: scale(1.05);
}

/* ---------------------- Buttons row ----------------------- */
.btn-row { display: flex; gap: 16px; flex-wrap: wrap; }

/* ---------------------- Hero common ----------------------- */
.hero {
  background: var(--navy-ink);
  color: #fff;
  position: relative;
  isolation: isolate;
  overflow: hidden;
  min-height: calc(100vh - 75px);
  display: flex;
  align-items: center;
  padding: clamp(60px, 7vw, 100px) 0 clamp(60px, 7vw, 100px);
}
.hero .container { width: 100%; }
.hero h1 { font-size: clamp(44px, 5.6vw, 88px); }
.hero .lead { font-size: clamp(15px, 1.15vw, 18px); }
.hero h1 { color: #fff; }
.hero .lead { color: rgba(255,255,255,0.75); }
.hero .kicker { color: var(--orange); }

.hero-grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  pointer-events: none;
  mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
}
.hero-orange-blob {
  position: absolute;
  width: 720px; height: 720px;
  right: -200px; top: -200px;
  background: radial-gradient(circle, rgba(243,112,33,0.32) 0%, transparent 60%);
  pointer-events: none;
}
.hero-content { position: relative; z-index: 2; }

.hero-image {
  position: absolute;
  inset: 0;
  z-index: -3;
}
.hero-image img { object-fit: cover; object-position: right center; }
.hero-image-tint {
  position: absolute;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(11,23,48,0.92) 0%, rgba(11,23,48,0.78) 38%, rgba(11,23,48,0.5) 62%, rgba(11,23,48,0.28) 100%);
}
@media (max-width: 760px) {
  .hero-image-tint { background: linear-gradient(180deg, rgba(11,23,48,0.65) 0%, rgba(11,23,48,0.92) 70%); }
}

/* ---------------------- Domain / capability cards ----------------------- */
.domain-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
@media (max-width: 760px) { .domain-grid { grid-template-columns: 1fr; } }
.domain {
  background: #fff;
  padding: 48px 40px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-height: 360px;
  transition: background var(--t-fast);
  position: relative;
}
.domain:hover { background: var(--bone); }
.domain-icon {
  width: 56px; height: 56px;
  border: 1.5px solid var(--navy-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  color: var(--navy-ink);
}
.domain-num {
  position: absolute;
  top: 24px; right: 28px;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--slate-soft);
  letter-spacing: 0.1em;
}
.domain h3 { font-size: clamp(28px, 2.6vw, 40px); }
.domain p { color: var(--slate); flex-grow: 1; }
.domain-cta {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 15px;
  letter-spacing: 0.04em;
  color: var(--orange);
  display: inline-flex; align-items: center; gap: 10px;
  transition: gap var(--t-fast);
}
.domain:hover .domain-cta { gap: 16px; }

/* ---------------------- Project / case study ----------------------- */
.case {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
  padding: 80px 0;
  border-bottom: 1px solid var(--line);
}
.case:last-child { border-bottom: none; }
.case.reverse .case-media { order: 2; }
@media (max-width: 980px) { .case { grid-template-columns: 1fr; gap: 32px; } .case.reverse .case-media { order: 0; } }

.case-media { min-height: 420px; }
@media (max-width: 980px) { .case-media { min-height: 0; } }
.case-num {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--orange);
  letter-spacing: 0.2em;
  margin-bottom: 12px;
}
.case-body { display: flex; flex-direction: column; gap: 18px; }
.case-body h3 { font-size: clamp(28px, 2.8vw, 44px); }
.case-highlights { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 10px; }
.case-highlights li {
  display: flex; gap: 12px; align-items: flex-start;
  font-size: 15px; color: var(--slate);
}
.case-highlights li::before {
  content: ""; flex: 0 0 10px; height: 10px; margin-top: 7px;
  background: var(--orange);
  transform: rotate(45deg);
}

/* ---------------------- Final CTA section ----------------------- */
.final-cta {
  background: var(--navy-ink);
  color: #fff;
  padding: clamp(60px, 7vw, 100px) 0;
  position: relative;
  overflow: hidden;
}
.final-cta h2 { color: #fff; max-width: 18ch; }
.final-cta .lead { color: rgba(255,255,255,0.75); max-width: 56ch; margin-top: 24px; }
.final-cta-inner {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 60px;
  align-items: end;
  position: relative;
  z-index: 2;
}
@media (max-width: 980px) { .final-cta-inner { grid-template-columns: 1fr; } }
.final-cta-orange-blob {
  position: absolute;
  width: 600px; height: 600px;
  right: -150px; bottom: -200px;
  background: radial-gradient(circle, rgba(243,112,33,0.28) 0%, transparent 60%);
  pointer-events: none;
}

/* ---------------------- Misc ----------------------- */
.divider { height: 1px; background: var(--line); margin: 60px 0; border: none; }

.tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  padding: 5px 10px;
  background: var(--bone);
  color: var(--navy-ink);
  border-radius: 3px;
}
.tag-orange { background: var(--orange); color: #fff; }
.tag-outline { background: transparent; border: 1px solid var(--line); color: var(--slate); }

.pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 100px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: rgba(243,112,33,0.12);
  color: var(--orange);
}

.list-bullets { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
.list-bullets li {
  padding-left: 22px;
  position: relative;
  font-size: 15px;
  color: var(--slate);
  line-height: 1.5;
}
.list-bullets li::before {
  content: "";
  position: absolute;
  left: 0; top: 9px;
  width: 8px; height: 2px; background: var(--orange);
}

/* ---------------------- Animation ----------------------- */
@keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.fade-up { animation: fadeUp 0.8s cubic-bezier(.2,.7,.2,1) both; }
.fade-up.d1 { animation-delay: 0.1s; }
.fade-up.d2 { animation-delay: 0.2s; }
.fade-up.d3 { animation-delay: 0.3s; }
.fade-up.d4 { animation-delay: 0.4s; }

/* Scroll-reveal: elements fade + rise into view as the page is scrolled.
   Cascading transition-delay (set in ScrollReveal.tsx) gives sibling
   cards a gentle wave-like sequence. */
@media (prefers-reduced-motion: no-preference) {
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.45s cubic-bezier(.16,1,.3,1), transform 0.45s cubic-bezier(.16,1,.3,1);
  }
  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Smooth page-enter transition on every route change */
@keyframes pageEnter {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}
.page-transition { animation: pageEnter var(--t-smooth) both; }
@media (prefers-reduced-motion: reduce) {
  .page-transition { animation: none; }
}

/* prevent jump for sections starting orange */
.bg-bone { background: var(--bone); }
.bg-navy { background: var(--navy-ink); color: #fff; }
.bg-navy h2, .bg-navy h3 { color: #fff; }
.bg-navy .lead { color: rgba(255,255,255,0.75); }
.bg-navy .stat-num { color: #fff; }
.bg-navy .stat { border-color: rgba(255,255,255,0.12); }
.bg-navy .stats-strip { border-color: rgba(255,255,255,0.12); }
.bg-navy .kicker { color: var(--orange); }
.bg-navy p { color: rgba(255,255,255,0.75); }
.bg-navy .list-bullets li { color: rgba(255,255,255,0.75); }
.bg-navy .card { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.1); color: #fff; }
.bg-navy .card h4 { color: #fff; }
.bg-navy .card p { color: rgba(255,255,255,0.7); }

/* form inputs */
.input, .select, .textarea {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid var(--line);
  background: #fff;
  border-radius: var(--radius);
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--ink);
  transition: border-color var(--t-fast);
}
.input:focus, .select:focus, .textarea:focus { outline: none; border-color: var(--orange); }
.label {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--slate);
  margin-bottom: 8px;
  display: block;
}
.field { display: flex; flex-direction: column; }

/* ---------------------- Media Section ----------------------- */
.media-section .section-head { margin-bottom: 48px; }

.media-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 12px;
  align-items: start;
}
@media (max-width: 980px) { .media-grid { grid-template-columns: repeat(6, 1fr); gap: 12px; } }
@media (max-width: 560px) { .media-grid { grid-template-columns: 1fr; } }

.media-item {
  position: relative;
  background: var(--bone);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: transform var(--t-fast), border-color var(--t-fast), box-shadow var(--t-fast);
  display: flex;
  flex-direction: column;
  min-height: 260px;
}
.media-item:hover {
  transform: translateY(-4px);
  border-color: var(--orange);
  box-shadow: 0 24px 48px -28px rgba(31,58,109,0.3);
}

/* sizing variants */
.media-item.span-feature { grid-column: span 6; min-height: 380px; }
.media-item.span-half    { grid-column: span 6; min-height: 320px; }
.media-item.span-third   { grid-column: span 4; min-height: 280px; }
.media-item.span-quarter { grid-column: span 3; min-height: 240px; }
@media (max-width: 980px) {
  .media-item.span-feature { grid-column: span 6; min-height: 320px; }
  .media-item.span-half    { grid-column: span 6; }
  .media-item.span-third   { grid-column: span 3; min-height: 220px; }
  .media-item.span-quarter { grid-column: span 3; min-height: 200px; }
}
@media (max-width: 560px) {
  .media-item.span-feature,
  .media-item.span-half,
  .media-item.span-third,
  .media-item.span-quarter { grid-column: span 1; }
}

/* Visual area (newspaper cutting / video thumbnail placeholder) */
.media-visual {
  position: relative;
  flex: 1;
  background: repeating-linear-gradient(45deg, #ECE6D6 0 10px, #E4DDC9 10px 20px);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  min-height: 140px;
}
.media-visual.dark {
  background: repeating-linear-gradient(45deg, #1B2B4A 0 10px, #15233D 10px 20px);
}
.media-visual img {
  width: 100%; height: 100%;
  object-fit: cover;
  position: absolute; inset: 0;
}

/* Newspaper clipping illustration */
.clipping {
  width: 75%;
  max-width: 280px;
  background: #FAF6EC;
  padding: 16px 14px;
  border-radius: 2px;
  box-shadow: 0 14px 30px -16px rgba(11,23,48,0.5);
  transform: rotate(-1.4deg);
  font-family: Georgia, "Times New Roman", serif;
  color: #1a1a1a;
  position: relative;
}
.clipping::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--ink);
}
.clipping-masthead {
  font-family: var(--font-display);
  font-weight: 900;
  font-style: italic;
  font-size: 12px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ink);
  padding-bottom: 4px;
  margin-bottom: 8px;
  border-bottom: 1px solid #c8bea4;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.clipping-masthead span:last-child { font-family: var(--font-mono); font-size: 8px; font-style: normal; font-weight: 500; color: #6b624a; }
.clipping-headline {
  font-weight: 700;
  font-size: 13.5px;
  line-height: 1.15;
  margin-bottom: 6px;
  letter-spacing: -0.005em;
}
.clipping-lines {
  display: grid;
  gap: 3px;
}
.clipping-lines span {
  display: block;
  height: 2px;
  background: #8a7f63;
  opacity: 0.5;
  border-radius: 1px;
}
.clipping-lines span:nth-child(1) { width: 100%; }
.clipping-lines span:nth-child(2) { width: 92%; }
.clipping-lines span:nth-child(3) { width: 96%; }
.clipping-lines span:nth-child(4) { width: 70%; }
.clipping-lines span:nth-child(5) { width: 88%; }
.clipping-lines span:nth-child(6) { width: 60%; }
.clipping-image-block {
  height: 38px;
  background: #1F3A6D;
  margin: 8px 0;
  position: relative;
  overflow: hidden;
}
.clipping-image-block::after {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(45deg, transparent 0 6px, rgba(255,255,255,0.15) 6px 12px);
}

/* Video play overlay */
.media-play {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 72px; height: 72px;
  border-radius: 50%;
  background: var(--orange);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16px 40px -8px rgba(243,112,33,0.6);
  transition: transform var(--t-fast), background var(--t-fast);
  z-index: 2;
}
.media-item:hover .media-play { transform: translate(-50%, -50%) scale(1.08); background: var(--orange-bright); }
.media-play svg { width: 24px; height: 24px; margin-left: 3px; fill: #fff; }

/* TV / screen frame for video tiles */
.video-frame {
  width: 78%;
  max-width: 320px;
  aspect-ratio: 16 / 10;
  background: #0B1730;
  border-radius: 4px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16px 36px -16px rgba(0,0,0,0.6);
}
.video-frame::before {
  content: "";
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(243,112,33,0.18) 1px, transparent 1px),
    linear-gradient(90deg, rgba(243,112,33,0.18) 1px, transparent 1px);
  background-size: 24px 24px;
}
.video-frame .duration {
  position: absolute;
  bottom: 8px; right: 8px;
  background: rgba(0,0,0,0.7);
  color: #fff;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  padding: 2px 6px;
  border-radius: 2px;
  z-index: 3;
}
.video-frame .channel-bug {
  position: absolute;
  top: 8px; left: 8px;
  background: #DC2626;
  color: #fff;
  font-family: var(--font-display);
  font-weight: 900;
  font-style: italic;
  font-size: 10px;
  letter-spacing: 0.1em;
  padding: 3px 7px;
  border-radius: 2px;
  z-index: 3;
}
.video-frame .channel-bug.flowers { background: #E11D48; }
.video-frame .channel-bug.youtube { background: #DC2626; }

/* News marquee (auto-scrolling press coverage strip) */
.news-marquee {
  overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
}
.news-marquee-track {
  display: inline-flex;
  align-items: flex-start;
  gap: 24px;
  animation: news-marquee 50s linear infinite;
}
.news-marquee:hover .news-marquee-track { animation-play-state: paused; }
.news-marquee-item {
  position: relative;
  width: 320px;
  flex-shrink: 0;
  align-self: flex-start;
  background: var(--bone);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--t-fast), border-color var(--t-fast), box-shadow var(--t-fast);
}
.news-marquee-item:hover {
  transform: translateY(-4px);
  border-color: var(--orange);
  box-shadow: 0 24px 48px -28px rgba(31,58,109,0.3);
}
.news-marquee-item .media-visual { flex: none; min-height: 0; }
@keyframes news-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
@media (max-width: 560px) {
  .news-marquee-item { width: 260px; }
}

/* Caption strip */
.media-caption {
  background: #fff;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-top: 1px solid var(--line);
}
.media-caption .source {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--orange);
  display: flex;
  align-items: center;
  gap: 8px;
}
.media-caption .source::after {
  content: attr(data-date);
  margin-left: auto;
  color: var(--slate-soft);
  font-size: 9px;
  letter-spacing: 0.1em;
}
.media-caption h4 {
  font-family: var(--font-display);
  font-weight: 700;
  font-style: italic;
  font-size: 17px;
  letter-spacing: 0.005em;
  line-height: 1.2;
  color: var(--navy-ink);
  text-transform: none;
}
.media-caption .kind {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--slate);
  display: flex; align-items: center; gap: 6px;
}
.media-caption .kind::before {
  content: ""; width: 6px; height: 6px;
  background: var(--orange); border-radius: 50%;
}
.media-caption .kind.video::before { background: #DC2626; }

/* Logos bar (publications featured in) */
.media-logos {
  margin-top: 56px;
  padding: 28px 32px;
  border: 1px dashed var(--line);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
  justify-content: space-between;
}
.media-logos .label {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--slate);
}
.media-logos-list {
  display: flex; flex-wrap: wrap; gap: 36px 48px; align-items: center;
}
.media-logo-mark {
  font-family: var(--font-display);
  font-weight: 900;
  font-style: italic;
  font-size: 22px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--navy-ink);
  opacity: 0.5;
  transition: opacity var(--t-fast);
}
.media-logo-mark:hover { opacity: 1; }



/* ============================================================
   PAGE-SPECIFIC STYLES
   ============================================================ */

/* --- home --- */
/* ============================================================
       HERO — Full-bleed video background with tech-vibe overlays
       ============================================================ */
    .hero-home {
      padding: 0;
      min-height: calc(100vh - 76px);
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      isolation: isolate;
      /* Solid fallback while video loads / on low bandwidth */
      background:
        radial-gradient(ellipse at 75% 30%, rgba(243,112,33,0.28), transparent 55%),
        linear-gradient(135deg, #14264A 0%, #0B1730 100%);
    }

    /* The video itself */
    .hero-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -3;
      /* Tech grading: high contrast, desaturated, slightly dimmed */
      filter: brightness(0.55) contrast(1.25) saturate(0.55) hue-rotate(-8deg);
      /* CSS pixelation hint (renders blockier when scaled) */
      image-rendering: pixelated;
      image-rendering: -moz-crisp-edges;
    }

    /* Pixelation effect: re-render the video through a halftone-dot mask
       to give a "low-res LED panel" texture without re-encoding the video.
       This is purely a CSS overlay — no JS, no canvas, no extra bandwidth. */
    .hero-pixel-overlay {
      position: absolute;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      /* Dot matrix grid — looks like an LED screen */
      background-image:
        radial-gradient(circle at center, rgba(0,0,0,0.55) 1.4px, transparent 1.6px);
      background-size: 5px 5px;
      mix-blend-mode: multiply;
      opacity: 0.85;
    }
    /* Larger pixel grid layered on top for a stronger pixel look on big areas */
    .hero-pixel-overlay::before {
      content: "";
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(11,23,48,0.4) 1px, transparent 1px),
        linear-gradient(90deg, rgba(11,23,48,0.4) 1px, transparent 1px);
      background-size: 4px 4px;
    }

    /* Navy tint pass — pushes the video into the brand color space */
    .hero-tint {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(ellipse at 80% 30%, rgba(243,112,33,0.35) 0%, transparent 50%),
        linear-gradient(180deg, rgba(11,23,48,0.5) 0%, rgba(11,23,48,0.72) 100%);
    }

    /* Existing grid + orange blob still help structure the type */
    .hero-home .hero-grid-bg {
      mask-image: radial-gradient(ellipse at center, #000 30%, transparent 85%);
      -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 85%);
      opacity: 0.5;
    }
    .hero-home .hero-orange-blob { opacity: 0.55; }

    /* CRT-style scanlines — subtle */
    .hero-scanlines {
      position: absolute; inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image: repeating-linear-gradient(
        to bottom,
        rgba(255,255,255,0.0) 0px,
        rgba(255,255,255,0.0) 2px,
        rgba(0,0,0,0.06) 3px,
        rgba(0,0,0,0.06) 3px
      );
      mix-blend-mode: overlay;
    }

    /* Single-column hero content centered for video-bg layout */
    .hero-home .container {
      position: relative;
      z-index: 2;
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .hero-home .hero-content {
      display: block;
      max-width: 1000px;
    }
    .hero-home h1 {
      font-size: clamp(40px, 6vw, 88px);
      line-height: 0.94;
      max-width: 16ch;
    }
    .hero-home .lead {
      max-width: 60ch;
      font-size: clamp(15px, 1.15vw, 19px);
    }

    /* Reduce video weight on small screens — solid fallback shows instead */
    @media (max-width: 720px) {
      .hero-video { display: none; }
      .hero-pixel-overlay,
      .hero-scanlines { opacity: 0.4; }
    }
    /* Respect reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .hero-video { display: none; }
    }

    /* Floating tech tags (kept — they sell the vibe) */
    .hero-tags {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 3;
    }
    .hero-tag {
      position: absolute;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.9);
      background: rgba(11,23,48,0.75);
      border: 1px solid rgba(243,112,33,0.5);
      padding: 6px 10px;
      border-radius: 3px;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .hero-tag::before {
      content: ""; display: inline-block; width: 6px; height: 6px;
      background: var(--orange); border-radius: 50%; margin-right: 8px;
      vertical-align: middle;
      box-shadow: 0 0 10px var(--orange);
    }
    .hero-tag.t1 { top: 14%; right: 6%; }
    .hero-tag.t2 { bottom: 24%; right: 8%; }
    .hero-tag.t3 { bottom: 14%; left: 6%; }
    @media (max-width: 760px) { .hero-tag { display: none; } }


    .innovation-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    @media (max-width: 980px) { .innovation-row { grid-template-columns: 1fr; } }

    .product-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform var(--t-med), border-color var(--t-med), box-shadow var(--t-med);
    }
    .product-card:hover { transform: translateY(-6px); border-color: var(--orange); box-shadow: 0 30px 60px -30px rgba(31,58,109,0.25); }
    .product-card .media { min-height: 220px; border-radius: 0; border: none; border-bottom: 1px solid var(--line); }
    .product-card-body { padding: 28px; display: flex; flex-direction: column; gap: 14px; flex-grow: 1; }
    .product-tag-line { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; color: var(--orange); text-transform: uppercase; }
    .product-card h4 { font-size: 22px; }
    .product-card p { font-size: 14.5px; color: var(--slate); line-height: 1.55; flex-grow: 1; }
    .product-card .domain-cta { font-size: 13px; }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1px;
      background: rgba(255,255,255,0.12);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    @media (max-width: 760px) { .pillars-grid { grid-template-columns: 1fr; } }
    .pillar {
      background: var(--navy-ink);
      padding: 48px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      position: relative;
      border: 1px solid transparent;
      transition: transform var(--t-med), border-color var(--t-med);
    }
    .pillar:hover { transform: translateY(-4px); border-color: var(--orange); }
    .pillar-num {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      font-size: 64px;
      line-height: 0.9;
      color: var(--orange);
    }
    .pillar h4 { color: #fff; }
    .pillar p { color: rgba(255,255,255,0.7); }

    .marquee-strip {
      background: var(--orange);
      color: #fff;
      padding: 20px 0;
      overflow: hidden;
      white-space: nowrap;
    }
    .marquee-track {
      display: inline-flex;
      gap: 56px;
      animation: marquee 28s linear infinite;
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      font-size: 22px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .marquee-track span::after {
      content: "◇";
      margin-left: 56px;
      opacity: 0.5;
    }
    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

/* --- robotics --- */
.capability-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
    @media (max-width: 980px) { .capability-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .capability-grid { grid-template-columns: 1fr; } }
    .capability {
      background: #fff;
      padding: 32px 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-height: 240px;
      transition: background var(--t-fast);
    }
    .capability:hover { background: var(--bone); }
    .capability-icon {
      width: 44px; height: 44px;
      border: 1.5px solid var(--orange);
      display: flex; align-items: center; justify-content: center;
      color: var(--orange);
    }
    .capability h4 { font-size: 18px; }
    .capability p { font-size: 13.5px; color: var(--slate); line-height: 1.5; }
    .capability-num { font-family: var(--font-mono); font-size: 10px; color: var(--slate-soft); letter-spacing: 0.1em; }

    .case-visuals-list {
      list-style: none; padding: 0; margin: 12px 0 0;
      display: flex; flex-wrap: wrap; gap: 8px;
    }
    .case-visuals-list li {
      font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--slate);
      padding: 4px 10px; background: var(--bone); border-radius: 3px;
    }

/* --- ai --- */
/* Value flow */
    .value-flow {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
      margin-top: 48px;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    @media (max-width: 980px) { .value-flow { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .value-flow { grid-template-columns: 1fr; } }
    .flow-step {
      background: #fff;
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      transition: background var(--t-med);
      border-right: 1px solid var(--line);
    }
    .flow-step:last-child { border-right: none; }
    .flow-step:hover { background: var(--bone); }
    .flow-step .num {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--orange);
      letter-spacing: 0.15em;
    }
    .flow-step h4 {
      font-size: 22px;
      letter-spacing: 0.01em;
    }
    .flow-step::after {
      content: "→";
      position: absolute;
      right: -10px; top: 50%;
      transform: translateY(-50%);
      background: var(--paper);
      color: var(--orange);
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      font-size: 20px;
      padding: 4px 6px;
      z-index: 2;
    }
    .flow-step:last-child::after { display: none; }
    @media (max-width: 980px) { .flow-step::after { display: none; } }

    /* Solution card */
    .solution-card {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 40px;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-bottom: 24px;
      transition: transform var(--t-med), border-color var(--t-med), box-shadow var(--t-med);
    }
    .solution-card:hover { transform: translateY(-4px); border-color: var(--orange); box-shadow: 0 30px 60px -30px rgba(31,58,109,0.25); }
    @media (max-width: 980px) { .solution-card { grid-template-columns: 1fr; } }
    .solution-card .media { border-radius: 0; min-height: 320px; border: none; border-right: 1px solid var(--line); }
    @media (max-width: 980px) { .solution-card .media { border-right: none; border-bottom: 1px solid var(--line); } }
    .solution-body { padding: 40px; display: flex; flex-direction: column; gap: 16px; }
    .solution-body h3 { font-size: clamp(26px, 2.4vw, 36px); }
    .solution-num { font-family: var(--font-mono); font-size: 11px; color: var(--orange); letter-spacing: 0.2em; }
    .two-col-list { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 12px; }
    @media (max-width: 600px) { .two-col-list { grid-template-columns: 1fr; } }
    .col-list-title {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--slate-soft);
      margin-bottom: 12px;
    }

    /* Industry tiles */
    .industry-card {
      background: #fff;
      border: 1px solid var(--line);
      padding: 28px;
      border-radius: var(--radius-lg);
      transition: transform var(--t-fast), border-color var(--t-fast);
    }
    .industry-card:hover { transform: translateY(-4px); border-color: var(--orange); }
    .industry-card h4 { margin-bottom: 14px; }

    .industries-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    @media (max-width: 980px) { .industries-strip { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .industries-strip { grid-template-columns: 1fr; } }
    .industry-pill {
      padding: 28px 20px;
      background: var(--bone);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      font-family: var(--font-display);
      font-weight: 900;
      font-style: italic;
      font-size: 22px;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--navy-ink);
      text-align: left;
      transition: background var(--t-fast), color var(--t-fast);
      display: flex; align-items: center; justify-content: space-between;
    }
    .industry-pill:hover { background: var(--orange); color: #fff; }
    .industry-pill::after { content: "→"; opacity: 0.6; }

    .analytics-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-top: 40px;
    }
    @media (max-width: 980px) { .analytics-list { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .analytics-list { grid-template-columns: 1fr; } }
    .analytics-list > div {
      background: #fff;
      padding: 22px 24px;
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 15px;
      color: var(--ink);
    }
    .analytics-list > div::before {
      content: ""; width: 8px; height: 8px; background: var(--orange); transform: rotate(45deg); flex-shrink: 0;
    }

    .quote-block {
      background: var(--navy-ink);
      color: #fff;
      padding: 60px;
      border-radius: var(--radius-lg);
      text-align: center;
      margin-top: 60px;
    }
    .quote-block .display-quote {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      font-size: clamp(28px, 3.2vw, 48px);
      line-height: 1;
      text-transform: uppercase;
      max-width: 22ch;
      margin: 0 auto;
    }
    .quote-block .display-quote .accent { color: var(--orange); }

/* --- roboparks --- */
.vision-banner {
      background: var(--orange);
      color: #fff;
      padding: 12px 22px;
      border-radius: 100px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .vision-banner::before {
      content: ""; width: 8px; height: 8px; border-radius: 50%; background: #fff;
      animation: pulse 1.6s infinite;
    }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    .verticals-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    @media (max-width: 980px) { .verticals-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .verticals-grid { grid-template-columns: 1fr; } }
    .vertical {
      background: #fff;
      padding: 40px 32px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-height: 320px;
      transition: background var(--t-fast);
      position: relative;
    }
    @media (max-width: 560px) { .vertical { min-height: 0; } }
    .vertical:hover { background: var(--bone); }
    .vertical-num {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      font-size: 56px;
      color: var(--orange);
      line-height: 0.9;
    }
    .vertical h4 { font-size: 24px; letter-spacing: 0.01em; }
    .vertical p { color: var(--slate); font-size: 14.5px; }

    .park-card {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 0;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-bottom: 28px;
    }
    @media (max-width: 980px) { .park-card { grid-template-columns: 1fr; } }
    .park-card .media { border-radius: 0; min-height: 380px; border: none; overflow: hidden; }
    .park-card .media img { transition: transform 0.5s ease, filter 0.5s ease; }
    .park-card:hover .media img { transform: scale(1.04); filter: brightness(1.08); }
    .park-card .media::before { content: ''; position: absolute; inset: 0; background: rgba(243,112,33,0.08); opacity: 0; transition: opacity 0.5s ease; z-index: 1; pointer-events: none; }
    .park-card:hover .media::before { opacity: 1; }
    .park-body { padding: 48px; display: flex; flex-direction: column; gap: 18px; }
    .park-body h3 { font-size: clamp(34px, 3.4vw, 52px); }
    .park-tag {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--orange);
    }
    .park-positioning {
      padding: 18px 22px;
      background: var(--bone);
      border-left: 3px solid var(--orange);
      font-style: italic;
      color: var(--navy-ink);
      font-size: 15.5px;
      line-height: 1.5;
      margin-top: 8px;
    }
    .park-focus {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 12px;
    }
    @media (max-width: 600px) { .park-focus { grid-template-columns: 1fr; } }

    /* Stakeholders */
    .stakeholders-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    @media (max-width: 980px) { .stakeholders-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .stakeholders-grid { grid-template-columns: 1fr; } }
    .stakeholder {
      padding: 24px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: var(--radius-lg);
      color: #fff;
      transition: background var(--t-fast), border-color var(--t-fast);
    }
    .stakeholder:hover { background: rgba(243,112,33,0.12); border-color: var(--orange); }
    .stakeholder-num {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.15em;
      color: var(--orange);
    }
    .stakeholder-name {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 700;
      font-size: 20px;
      text-transform: uppercase;
      margin-top: 8px;
      color: #fff;
    }

/* --- edutech --- */
/* Program card grid */
    .program-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    @media (max-width: 980px) { .program-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .program-grid { grid-template-columns: 1fr; } }
    .program {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      transition: transform var(--t-fast), border-color var(--t-fast), box-shadow var(--t-fast);
      position: relative;
    }
    .program:hover { transform: translateY(-4px); border-color: var(--orange); box-shadow: 0 20px 40px -20px rgba(31,58,109,0.18); }
    .program-status {
      position: absolute; top: 20px; right: 20px;
      font-family: var(--font-mono);
      font-size: 9px; letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 4px 8px; border-radius: 2px;
    }
    .program-status.live { background: #16A34A; color: #fff; }
    .program-status.upcoming { background: var(--orange); color: #fff; }
    .program h4 { font-size: 22px; padding-right: 80px; }
    .program-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 16px;
      padding: 14px 0;
      border-top: 1px dashed var(--line);
      border-bottom: 1px dashed var(--line);
    }
    .program-meta div { font-size: 12px; color: var(--slate); }
    .program-meta div strong { display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate-soft); font-weight: 500; margin-bottom: 3px; }
    .program-outcome {
      font-size: 13.5px; color: var(--ink); line-height: 1.5;
    }
    .program .domain-cta { margin-top: auto; font-size: 13px; }

    .topic-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
    }
    .topic-chip {
      padding: 10px 18px;
      background: var(--bone);
      border: 1px solid var(--line);
      border-radius: 100px;
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 600;
      font-size: 16px;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--navy-ink);
      transition: background var(--t-fast), color var(--t-fast);
      cursor: default;
    }
    .topic-chip:hover { background: var(--orange); color: #fff; border-color: var(--orange); }

    .split-block {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    @media (max-width: 980px) { .split-block { grid-template-columns: 1fr; } }

    .lab-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    @media (max-width: 760px) { .lab-grid { grid-template-columns: 1fr; } }
    .lab-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: transform var(--t-med), border-color var(--t-med), box-shadow var(--t-med);
    }
    .lab-card:hover { transform: translateY(-4px); border-color: var(--orange); box-shadow: 0 30px 60px -30px rgba(31,58,109,0.25); }
    .lab-card .media { border-radius: 0; border: none; min-height: 220px; border-bottom: 1px solid var(--line); }
    .lab-body { padding: 32px; display: flex; flex-direction: column; gap: 14px; }
    .lab-body h4 { font-size: 24px; }

    .benefit-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-top: 32px;
    }
    @media (max-width: 760px) { .benefit-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .benefit-grid { grid-template-columns: 1fr; } }
    .benefit {
      background: #fff;
      padding: 24px;
      font-size: 14px;
      color: var(--ink);
      display: flex; align-items: center; gap: 12px;
      transition: background var(--t-med);
    }
    .benefit:hover { background: var(--bone); }
    .benefit::before { content: ""; width: 6px; height: 24px; background: var(--orange); flex-shrink: 0; transition: height var(--t-fast); }
    .benefit:hover::before { height: 32px; }

/* --- careers --- */
.highlight-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
    }
    @media (max-width: 980px) { .highlight-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .highlight-grid { grid-template-columns: 1fr; } }
    .highlight {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 140px;
      transition: background var(--t-fast);
    }
    @media (max-width: 480px) { .highlight { min-height: 0; } }
    .highlight:hover { background: var(--bone); border-color: var(--orange); }
    .highlight-num { font-family: var(--font-mono); font-size: 10px; color: var(--orange); letter-spacing: 0.15em; }
    .highlight h4 { font-size: 17px; line-height: 1.1; }

    .openings-empty {
      background: var(--bone);
      border: 2px dashed var(--line);
      border-radius: var(--radius-lg);
      padding: 60px;
      text-align: center;
    }
    .openings-empty .display-quote {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      font-size: clamp(32px, 3.4vw, 56px);
      line-height: 1;
      text-transform: uppercase;
      color: var(--navy-ink);
      max-width: 20ch;
      margin: 0 auto 18px;
    }

    .domain-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }
    .domain-pill {
      padding: 12px 20px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 100px;
      font-family: var(--font-display);
      font-weight: 600;
      font-style: italic;
      font-size: 15px;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: #fff;
      transition: background var(--t-fast), border-color var(--t-fast);
    }
    .domain-pill:hover { background: var(--orange); border-color: var(--orange); }
    .ojt-benefits {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-top: 40px;
    }
    @media (max-width: 980px) { .ojt-benefits { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .ojt-benefits { grid-template-columns: 1fr; } }
    .ojt-benefits > div {
      background: var(--navy-ink);
      padding: 24px;
      color: rgba(255,255,255,0.85);
      font-size: 14px;
      display: flex; align-items: center; gap: 12px;
    }
    .ojt-benefits > div::before { content: ""; width: 6px; height: 22px; background: var(--orange); flex-shrink: 0; }

    /* Mock job card sample for "when openings are available" */
    .role-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 32px;
    }
    @media (max-width: 760px) { .role-grid { grid-template-columns: 1fr; } }
    .role {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      opacity: 0.55;
      filter: grayscale(0.4);
      position: relative;
    }
    .role::after {
      content: "TEMPLATE PREVIEW";
      position: absolute; top: 12px; right: 12px;
      font-family: var(--font-mono);
      font-size: 9px; letter-spacing: 0.15em;
      color: var(--slate-soft);
    }
    .role-meta { display: flex; gap: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--slate); letter-spacing: 0.1em; text-transform: uppercase; }

/* --- about --- */
.mv-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    @media (max-width: 760px) { .mv-grid { grid-template-columns: 1fr; } }
    .mv {
      background: #fff;
      padding: 56px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      transition: background var(--t-med);
      position: relative;
      z-index: 1;
    }
    .mv:hover { background: var(--bone); }
    .mv-label {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--orange);
    }
    .mv-statement {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      font-size: clamp(36px, 4vw, 60px);
      line-height: 0.95;
      text-transform: uppercase;
      color: var(--navy-ink);
    }
    .mv-statement .accent { color: var(--orange); }

    /* Timeline */
    .timeline {
      position: relative;
      padding: 40px 0 0;
    }
    .timeline::before {
      content: "";
      position: absolute;
      top: 0; bottom: 0; left: 20px;
      width: 2px;
      background: var(--line);
    }
    @media (min-width: 760px) {
      .timeline::before { left: 50%; transform: translateX(-50%); }
    }
    .t-item {
      position: relative;
      padding-left: 56px;
      margin-bottom: 48px;
      max-width: 540px;
    }
    .t-item::before {
      content: "";
      position: absolute;
      left: 14px; top: 8px;
      width: 14px; height: 14px;
      background: var(--orange);
      border: 3px solid var(--paper);
      transform: rotate(45deg);
      transition: transform var(--t-fast), background var(--t-fast);
    }
    .t-item:hover::before { transform: rotate(45deg) scale(1.35); background: var(--orange-bright); }
    @media (min-width: 760px) {
      .t-item { width: calc(50% - 40px); padding-left: 0; padding-right: 40px; text-align: right; margin-left: 0; }
      .t-item:nth-child(even) { margin-left: calc(50% + 40px); padding-left: 40px; padding-right: 0; text-align: left; }
      .t-item::before { left: auto; right: -47px; transform: rotate(45deg); }
      .t-item:nth-child(even)::before { left: -47px; right: auto; }
      .t-item:hover::before { transform: rotate(45deg) scale(1.35); }
      .t-item:nth-child(even):hover::before { transform: rotate(45deg) scale(1.35); }
    }
    .t-phase {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 6px;
    }
    .t-title {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 900;
      font-size: clamp(22px, 2vw, 30px);
      letter-spacing: 0.005em;
      line-height: 1;
      text-transform: uppercase;
      color: var(--navy-ink);
      margin: 0 0 8px;
    }
    .t-desc { color: var(--slate); font-size: 14.5px; line-height: 1.5; }

    /* Leadership */
    .leader-grid {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0 32px;
      padding: 0 0 40px;
      overflow: visible;
      max-width: 800px;
      margin: 0 auto;
    }
    .leader-grid::before { content: none; }
    .leader-brushstroke {
      position: absolute;
      top: -5%;
      left: 50%;
      transform: translateX(-50%);
      width: 110vw;
      height: auto;
      z-index: 0;
      pointer-events: none;
      opacity: 0.92;
    }
    @media (max-width: 980px) { .leader-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .leader-grid { grid-template-columns: 1fr; } }
    .leader {
      position: relative;
      z-index: 1;
      background: transparent;
      border: none;
      border-radius: 0;
      overflow: visible;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: transform var(--t-fast);
    }
    .leader:hover { transform: translateY(-6px); }
    .leader-photo {
      position: relative;
      width: 100%;
      max-width: 300px;
      aspect-ratio: 3/4;
      border-radius: 0;
      background: transparent;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      overflow: visible;
      margin: 0 auto;
    }
    .leader-photo::after { content: none; }
    .leader-photo::before { content: none; }
    .leader-photo svg { width: 60%; height: 60%; opacity: 0.4; }
    .leader-photo img { width: 100%; height: 100%; object-fit: contain; object-position: bottom; transition: transform 0.5s ease; display: block; filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 2px #fff) drop-shadow(0 0 3px #fff); }
    .leader:hover .leader-photo img { transform: scale(1.04); }
    .leader-body { padding: 16px 8px 0; display: flex; flex-direction: column; align-items: center; gap: 4px; position: relative; z-index: 2; }
    .leader h4 { font-size: 18px; }
    .leader-role { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--orange); }
    .leader-bio { font-size: 13.5px; color: var(--slate); line-height: 1.5; }
    .leader-linkedin {
      font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--navy-ink);
      display: inline-flex; align-items: center; gap: 6px; margin-top: 6px;
    }
    .leader-linkedin::before { content: "in"; background: var(--navy-ink); color: #fff; font-family: var(--font-display); font-weight: 700; font-style: italic; padding: 1px 6px; border-radius: 2px; }

    /* Impact strip */
    .impact-strip {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 0;
      border-top: 1px solid rgba(255,255,255,0.12);
      border-bottom: 1px solid rgba(255,255,255,0.12);
    }
    @media (max-width: 980px) { .impact-strip { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .impact-strip { grid-template-columns: 1fr 1fr; } }
    .impact-strip .stat { border-color: rgba(255,255,255,0.12); }
    .impact-strip .stat-num { color: #fff; }
    .impact-strip .stat-label { color: rgba(255,255,255,0.55); }

/* --- contact --- */
.contact-layout {
      display: grid;
      grid-template-columns: 0.9fr 1.4fr;
      gap: 80px;
      align-items: start;
    }
    @media (max-width: 980px) { .contact-layout { grid-template-columns: 1fr; gap: 48px; } }

    .contact-card {
      background: var(--navy-ink);
      color: #fff;
      padding: 48px;
      border-radius: var(--radius-lg);
      position: relative;
      overflow: hidden;
      transition: box-shadow var(--t-med), transform var(--t-med);
    }
    .contact-card:hover { transform: translateY(-4px); box-shadow: 0 30px 70px -30px rgba(243,112,33,0.4); }
    .contact-map { margin-top: 32px; border-radius: var(--radius); overflow: hidden; position: relative; z-index: 1; }
    .contact-map iframe { display: block; filter: grayscale(0.3) contrast(1.05); transition: filter var(--t-med); }
    .contact-map:hover iframe { filter: grayscale(0) contrast(1); }
    .contact-card::after {
      content: "";
      position: absolute;
      right: -100px; bottom: -100px;
      width: 280px; height: 280px;
      background: radial-gradient(circle, rgba(243,112,33,0.3) 0%, transparent 60%);
    }
    .contact-card h3 {
      color: #fff;
      font-size: 36px;
      margin-bottom: 20px;
    }
    .contact-card p { color: rgba(255,255,255,0.75); font-size: 15px; line-height: 1.55; }
    .contact-info {
      list-style: none; padding: 0; margin: 32px 0 0;
      display: grid; gap: 20px;
    }
    .contact-info li {
      position: relative; z-index: 1;
    }
    .contact-info .ci-label {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--orange);
      margin-bottom: 6px;
    }
    .contact-info .ci-value {
      font-family: var(--font-display);
      font-weight: 700;
      font-style: italic;
      font-size: 22px;
      color: #fff;
      letter-spacing: 0.01em;
    }
    .contact-info .ci-sub { font-size: 13.5px; color: rgba(255,255,255,0.65); margin-top: 4px; }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    @media (max-width: 600px) { .form-grid { grid-template-columns: 1fr; } }
    .form-grid .span-2 { grid-column: span 2; }
    @media (max-width: 600px) { .form-grid .span-2 { grid-column: span 1; } }

    .inquiry-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 8px;
    }
    @media (max-width: 760px) { .inquiry-cards { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .inquiry-cards { grid-template-columns: 1fr; } }
    .inquiry-card {
      padding: 14px;
      background: #fff;
      border: 1.5px solid var(--line);
      border-radius: var(--radius);
      cursor: pointer;
      transition: border-color var(--t-fast), background var(--t-fast);
      display: flex; align-items: center; gap: 10px;
      font-family: var(--font-display); font-style: italic; font-weight: 600;
      font-size: 14px; text-transform: uppercase; letter-spacing: 0.03em;
      color: var(--navy-ink);
    }
    .inquiry-card input { position: absolute; opacity: 0; pointer-events: none; }
    .inquiry-card .dot {
      width: 12px; height: 12px;
      border: 1.5px solid var(--slate-soft);
      border-radius: 2px;
      flex-shrink: 0;
      transition: background var(--t-fast), border-color var(--t-fast);
    }
    .inquiry-card:hover { border-color: var(--orange); }
    .inquiry-card input:checked + .dot {
      background: var(--orange); border-color: var(--orange);
      box-shadow: inset 0 0 0 3px #fff;
    }
    .inquiry-card:has(input:checked) { border-color: var(--orange); background: rgba(243,112,33,0.05); }

    .form-section {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 40px;
    }
    .form-section h3 { font-size: 26px; margin-bottom: 28px; }

    .field { margin-bottom: 20px; }

    .submit-btn {
      width: 100%;
      justify-content: center;
      font-size: 18px;
      padding: 20px;
    }

    .response-time {
      display: flex; align-items: center; gap: 10px;
      margin-top: 16px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--slate);
      letter-spacing: 0.08em;
    }
    .response-time::before {
      content: ""; width: 8px; height: 8px; border-radius: 50%;
      background: #16A34A;
      box-shadow: 0 0 0 4px rgba(22,163,74,0.18);
    }

/* --- gallery --- */
.gallery-photo { position: relative; cursor: pointer; }
.gallery-photo .photo-overlay { opacity: 0; transition: opacity 180ms; }
.gallery-photo .photo-caption { opacity: 0; transition: opacity 180ms; }
.gallery-photo:hover .photo-overlay { opacity: 1; }
.gallery-photo:hover .photo-caption { opacity: 1; }
